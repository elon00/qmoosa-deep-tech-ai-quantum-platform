# AI provider (optional; offline simulation mode remains available)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.7-flash"

# Public application URL
APP_URL="https://your-domain.example"

# Runtime
NODE_ENV="production"
PORT="3000"
TRUST_PROXY="false"
MAX_JSON_BYTES="256kb"
RATE_MAX="60"
RATE_MAX_BUCKETS="5000"

# Production integrations are intentionally opt-in and must be provisioned
# outside source control. Never commit private keys, API tokens, or secrets.

# Paid/provider-backed AI endpoint protection.
# In production, GEMINI_API_KEY requires authenticated server-to-server access.
# Use a cryptographically random secret of at least 32 characters.
QMOOSA_API_TOKEN="CHANGE_ME_WITH_A_RANDOM_32_PLUS_CHAR_SECRET"

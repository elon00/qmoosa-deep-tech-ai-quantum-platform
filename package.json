{
  "name": "qmoosa-deep-tech-ai-quantum-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "check:env": "node check-env.mjs",
    "check:truth": "node check-truth.mjs",
    "test:nist": "tsx tests/nist-pqc.test.mjs",
    "audit:crypto": "node scripts/audit-crypto.mjs",
    "reality:universal": "tsx scripts/reality-universal.ts",
    "reality:certify": "tsx scripts/generate-urs-certificate.ts",
    "compile:contracts": "node scripts/compile-contracts.mjs",
    "deploy:bnb": "node scripts/deploy-bnb.mjs",
    "wallet:qr": "node scripts/multichain-wallet.mjs",
    "test:company-os": "node company-os/self-test.mjs",
    "audit:company-os": "node company-os/audit.mjs",
    "company:run": "node company-os/orchestrator.mjs",
    "test:ai-infra": "tsx tests/ai-infra-router.test.mjs",
    "test:speechmatics": "tsx tests/speechmatics-physical-ai.test.mjs",
    "test:midnight": "tsx tests/midnight-compact.test.mjs",
    "test:bobsentinel": "tsx tests/bobsentinel-orchestrator.test.mjs",
    "test:agent-os": "tsx --test packages/agent-trust/test/*.test.ts packages/policy-engine/test/*.test.ts packages/smart-wallet/test/*.test.ts packages/agent-os/test/*.test.ts",
    "test": "npm run check:env && npm run check:truth && npm run test:nist && npm run test:ai-infra && npm run test:speechmatics && npm run test:midnight && npm run test:bobsentinel && npm run test:company-os && npm run test:agent-os && npm run audit:crypto && npm run compile:contracts && npm run reality:universal && npm run lint && npm run build"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@noble/curves": "^1.8.1",
    "@noble/hashes": "^1.7.1",
    "@noble/post-quantum": "^0.7.1",
    "@solana/web3.js": "^1.98.4",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@types/d3": "^7.4.3",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^5.0.4",
    "bs58": "^6.0.0",
    "canvas-confetti": "^1.9.4",
    "d3": "^7.9.0",
    "dotenv": "^17.2.3",
    "ethers": "^6.17.0",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^26.5.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.8",
    "utf-8-validate": "^5.0.10"
  }
}
